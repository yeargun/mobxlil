{
  "name": "@itslil/mobx",
  "version": "7.0.1",
  "description": "MobX 7.0.0 reimplemented in LilScript. Drop-in ESM/CJS/UMD runtime with official types.",
  "keywords": [
    "mobx",
    "observable",
    "reactive",
    "state management",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/mobxlil/",
  "bugs": "https://github.com/yeargun/mobxlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/mobxlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "umd:main": "./dist/mobx.umd.production.min.js",
  "unpkg": "./dist/mobx.umd.production.min.js",
  "jsdelivr": "./dist/mobx.umd.production.min.js",
  "jsnext:main": "./dist/mobx.esm.js",
  "module": "./dist/mobx.esm.js",
  "react-native": "./dist/mobx.esm.js",
  "types": "./dist/mobx.d.ts",
  "typings": "./dist/mobx.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/mobx.d.ts",
      "import": "./dist/mobx.mjs",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {},
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:min": "node scripts/build.mjs --min",
    "build:site": "node scripts/build-site.mjs",
    "test": "node scripts/build.mjs --dev && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:types": "tsc --noEmit -p tests/tsconfig.types.json",
    "test:mixed-versions": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.mixed.config.cjs --runInBand",
    "test:perf": "node scripts/perf.mjs",
    "test:e2e": "node e2e/run.mjs",
    "bench": "node scripts/bench.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:layer": "node scripts/measure-layer.mjs",
    "measure:layers": "node scripts/measure-all-layers.mjs",
    "examples": "node examples/serve.mjs",
    "check": "node scripts/check.mjs",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "node scripts/package-smoke.mjs && npm run check:pack && npm run check:site"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "conditional-type-checks": "^1.0.5",
    "esbuild": "^0.25.8",
    "google-closure-compiler": "20260803.0.0",
    "iterall": "^1.3.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-mock-console": "^2.0.0",
    "jsdom": "^26.1.0",
    "mkdirp": "^1.0.4",
    "mobx": "7.0.0",
    "playwright": "^1.54.2",
    "serializr": "^2.0.5",
    "tape": "^5.9.0",
    "terser": "^5.43.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
