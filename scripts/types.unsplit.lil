export bool isOverride(JsValue annotation) {
  return toStr(annotation["annotationType_"]) == "override";
}

export void assertAnnotable(JsValue adm, JsValue annotation, JsValue key) {
  if (DEV && !isAnnotation(annotation)) {
    die("Cannot annotate '" + toStr(adm["name_"]) + "." + stringifyKey(key) + "': Invalid annotation.");
  }
  if (DEV && !isOverride(annotation) && hasOwn(adm["appliedAnnotations_"], key)) {
    die("Cannot apply '" + toStr(annotation["annotationType_"]) + "' to '" + toStr(adm["name_"]) + "." + stringifyKey(key) + "':\nThe field is already annotated with '" + toStr(adm["appliedAnnotations_"][key]["annotationType_"]) + "'.\nRe-annotating fields is not allowed.\nUse 'override' annotation for methods overridden by subclass.");
  }
}

