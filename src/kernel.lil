JsValue persistentKeys = JS.array();

void initPersistentKeys() {
  push(persistentKeys, "mobxGuid");
  push(persistentKeys, "spyListeners");
  push(persistentKeys, "enforceActions");
  push(persistentKeys, "computedRequiresReaction");
  push(persistentKeys, "reactionRequiresObservable");
  push(persistentKeys, "observableRequiresReaction");
  push(persistentKeys, "allowStateReads");
  push(persistentKeys, "disableErrorBoundaries");
  push(persistentKeys, "runId");
  push(persistentKeys, "UNCHANGED");
}

initPersistentKeys();

JsValue createMobXGlobals() {
  JsValue g = JS.object();
  g["version"] = 7;
  g["UNCHANGED"] = JS.object();
  g["trackingDerivation"] = null;
  g["trackingContext"] = null;
  g["runId"] = 0;
  g["mobxGuid"] = 0;
  g["inBatch"] = 0;
  g["pendingUnobservations"] = JS.array();
  g["pendingReactions"] = JS.array();
  g["isRunningReactions"] = false;
  g["allowStateChanges"] = false;
  g["allowStateReads"] = true;
  g["enforceActions"] = true;
  g["spyListeners"] = JS.array();
  g["globalReactionErrorHandlers"] = JS.array();
  g["computedRequiresReaction"] = false;
  g["reactionRequiresObservable"] = false;
  g["observableRequiresReaction"] = false;
  g["disableErrorBoundaries"] = false;
  g["suppressReactionErrors"] = false;
  g["safeDescriptors"] = true;
  return g;
}

JsValue initGlobalState() {
  JsValue global = hostGlobal();
  if (global["__mobxInstanceCount"].truthy() && toInt(global["__mobxInstanceCount"]) > 0 && !global["__mobxGlobals"].truthy()) {
    canMergeGlobalState = false;
  }
  JsValue existing = global["__mobxGlobals"];
  if (existing.truthy() && toInt(existing["version"]) != 7) {
    canMergeGlobalState = false;
  }
  if (!canMergeGlobalState) {
    setTimeoutHost(JS.method0((JsValue _self) => {
      if (!isolateCalled) {
        die(35);
      }
      return undef();
    }), 1);
    return createMobXGlobals();
  } else if (existing.truthy()) {
    global["__mobxInstanceCount"] = toInt(global["__mobxInstanceCount"]) + 1;
    if (!existing["UNCHANGED"].truthy()) {
      existing["UNCHANGED"] = JS.object();
    }
    return existing;
  }
  global["__mobxInstanceCount"] = 1;
  JsValue created = createMobXGlobals();
  global["__mobxGlobals"] = created;
  return created;
}

export JsValue globalState = initGlobalState();

export int getNextId() {
  int id = toInt(globalState["mobxGuid"]) + 1;
  globalState["mobxGuid"] = id;
  return id;
}

string niceError(JsValue error, JsValue args) {
  if (isStr(error)) {
    return toStr(error);
  }
  int code = toInt(error);
  if (code == 0) {
    return "Invalid value for configuration 'enforceActions', expected 'never', 'always' or 'observed'";
  }
  if (code == 1) {
    return "Cannot apply '" + toStr(args[0]) + "' to '" + stringifyKey(args[1]) + "': Field not found.";
  }
  if (code == 5) {
    return "'keys()' can only be used on observable objects, arrays, sets and maps";
  }
  if (code == 6) {
    return "'values()' can only be used on observable objects, arrays, sets and maps";
  }
  if (code == 7) {
    return "'entries()' can only be used on observable objects, arrays and maps";
  }
  if (code == 8) {
    return "'set()' can only be used on observable objects, arrays and maps";
  }
  if (code == 9) {
    return "'remove()' can only be used on observable objects, arrays and maps";
  }
  if (code == 10) {
    return "'has()' can only be used on observable objects, arrays and maps";
  }
  if (code == 11) {
    return "'get()' can only be used on observable objects, arrays and maps";
  }
  if (code == 12) {
    return "Invalid annotation";
  }
  if (code == 13) {
    return "Dynamic observable objects cannot be frozen. If you're passing observables to 3rd party component/function that calls Object.freeze, pass copy instead: toJS(observable)";
  }
  if (code == 14) {
    return "Intercept handlers should return nothing or a change object";
  }
  if (code == 15) {
    return "Observable arrays cannot be frozen. If you're passing observables to 3rd party component/function that calls Object.freeze, pass copy instead: toJS(observable)";
  }
  if (code == 16) {
    return "Modification exception: the internal structure of an observable array was changed.";
  }
  if (code == 19) {
    return "Cannot initialize from classes that inherit from Map: " + toStr(args[0]["constructor"]["name"]);
  }
  if (code == 20) {
    return "Cannot initialize map from " + toStr(args[0]);
  }
  if (code == 21) {
    return "Cannot convert to map from '" + toStr(args[0]) + "'";
  }
  if (code == 23) {
    return "It is not possible to get index atoms from arrays";
  }
  if (code == 24) {
    return "Cannot obtain administration from " + toStr(args[0]);
  }
  if (code == 25) {
    return "the entry '" + toStr(args[0]) + "' does not exist in the observable map '" + toStr(args[1]) + "'";
  }
  if (code == 26) {
    return "please specify a property";
  }
  if (code == 27) {
    return "no observable property '" + stringifyKey(args[0]) + "' found on the observable object '" + toStr(args[1]) + "'";
  }
  if (code == 28) {
    return "Cannot obtain atom from " + toStr(args[0]);
  }
  if (code == 29) {
    return "Expecting some object";
  }
  if (code == 30) {
    return "invalid action stack. did you forget to finish an action?";
  }
  if (code == 31) {
    return "missing option for computed: get";
  }
  if (code == 32) {
    return "Cycle detected in computation " + toStr(args[0]) + ": " + toStr(args[1]);
  }
  if (code == 33) {
    return "The setter of computed value '" + toStr(args[0]) + "' is trying to update itself. Did you intend to update an _observable_ value, instead of the computed property?";
  }
  if (code == 34) {
    return "[ComputedValue '" + toStr(args[0]) + "'] It is not possible to assign a new value to a computed value.";
  }
  if (code == 35) {
    return "There are multiple, different versions of MobX active. Make sure MobX is loaded only once or use `configure({ isolateGlobalState: true })`";
  }
  if (code == 36) {
    return "isolateGlobalState should be called before MobX is running any reactions";
  }
  if (code == 37) {
    return "[mobx] `observableArray." + toStr(args[0]) + "()` mutates the array in-place, which is not allowed inside a derivation. Use `array.slice()." + toStr(args[0]) + "()` instead";
  }
  if (code == 38) {
    return "'ownKeys()' can only be used on observable objects";
  }
  if (code == 39) {
    return "'defineProperty()' can only be used on observable objects";
  }
  if (code == 40) {
    return "Out of range: " + toStr(args[0]);
  }
  if (code == 41) {
    return "Cannot initialize set from " + toStr(args[0]);
  }
  if (code == 42) {
    return "Invalid index: '" + toStr(args[0]) + "'";
  }
  if (code == 43) {
    return "Cannot apply '" + toStr(args[0]) + "' to '" + toStr(args[1]) + "' (kind: " + toStr(args[2]) + "):\n'" + toStr(args[0]) + "' can only be used on properties with a function value.";
  }
  if (code == 44) {
    return "'" + toStr(args[0]) + "' can only be used with 'makeObservable'";
  }
  return toStr(error);
}

export void dieRest(JsValue error, JsValue args) {
  if (DEV) {
    throwErr(makeError("[MobX] " + niceError(error, args)));
  }
  string extra = "";
  if (len(args) > 0) {
    extra = " " + toStr(JS.invoke(JS.invoke(args, "map", hostGlobal()["String"]), "join", ","));
  }
  throwErr(makeError("[MobX] minified error nr: " + toStr(error) + extra + ". See mobx.js.org/errors"));
}

export void die(JsValue error) {
  dieRest(error, JS.array());
}

export void die1(JsValue error, JsValue a) {
  JsValue args = JS.array();
  push(args, a);
  dieRest(error, args);
}

export void die2(JsValue error, JsValue a, JsValue b) {
  JsValue args = JS.array();
  push(args, a);
  push(args, b);
  dieRest(error, args);
}

export void die3(JsValue error, JsValue a, JsValue b, JsValue c) {
  JsValue args = JS.array();
  push(args, a);
  push(args, b);
  push(args, c);
  dieRest(error, args);
}

export bool compareIdentity(JsValue a, JsValue b) {
  return JS.strictEqual(a, b);
}

export bool compareDefault(JsValue a, JsValue b) {
  return objectIs(a, b);
}

export JsValue defaultEquals = JS.method2((JsValue _self, JsValue a, JsValue b) => {
  return objectIs(a, b);
});

bool hasMobXFlag(JsValue x, string flag) {
  return isObj(x) && JS.strictEqual(x[flag], true);
}

export bool isAtom(JsValue x) {
  return hasMobXFlag(x, "isMobXAtom");
}

export bool isComputedValue(JsValue x) {
  return hasMobXFlag(x, "isMobXComputedValue");
}

export bool isReaction(JsValue x) {
  return hasMobXFlag(x, "isMobXReaction");
}

export bool isObservableValue(JsValue x) {
  return hasMobXFlag(x, "isMobXObservableValue");
}

export bool isObservableMap(JsValue x) {
  return hasMobXFlag(x, "isMobXObservableMap");
}

export bool isObservableSet(JsValue x) {
  return hasMobXFlag(x, "isMobXObservableSet");
}

export bool isObservableArray(JsValue thing) {
  if (!isObj(thing)) {
    return false;
  }
  return hasMobXFlag(thing[$mobx], "isMobXObservableArrayAdministration");
}

export bool isObservableObject(JsValue thing) {
  if (!isObj(thing)) {
    return false;
  }
  return hasMobXFlag(thing[$mobx], "isMobXObservableObjectAdministration");
}

export bool isAction(JsValue thing) {
  return isFn(thing) && JS.strictEqual(thing["isMobxAction"], true);
}

export bool isFlow(JsValue fn) {
  if (JS.isNullish(fn)) {
    return false;
  }
  return JS.strictEqual(fn["isMobXFlow"], true);
}

export bool isSpyEnabled() {
  return DEV && len(globalState["spyListeners"]) > 0;
}

export void spyReport(JsValue event) {
  if (!DEV) {
    return;
  }
  JsValue listeners = globalState["spyListeners"];
  int n = len(listeners);
  if (n == 0) {
    return;
  }
  int i = 0;
  while (i < n) {
    call1(listeners[i], undef(), event);
    i = i + 1;
  }
}

export void spyReportStart(JsValue event) {
  if (!DEV) {
    return;
  }
  spyReport(assign3(JS.object(), event, record { spyReportStart: true }));
}

JsValue END_EVENT = record {
  type: "report-end",
  spyReportEnd: true
};

export void spyReportEnd(JsValue change) {
  if (!DEV) {
    return;
  }
  if (change.truthy()) {
    spyReport(assign3(JS.object(), change, record {
      type: "report-end",
      spyReportEnd: true
    }));
  } else {
    spyReport(END_EVENT);
  }
}

export void spyReportEnd0() {
  spyReportEnd(undef());
}

export JsValue spy = JS.method1((JsValue _self, JsValue listener) => {
  if (!DEV) {
    warn("[mobx.spy] Is a no-op in production builds");
    return JS.method0((JsValue __self) => {
      return undef();
    });
  }
  push(globalState["spyListeners"], listener);
  return once(JS.method0((JsValue __self) => {
    globalState["spyListeners"] = filterArrKeep(globalState["spyListeners"], listener);
    return undef();
  }));
});

JsValue filterArrKeep(JsValue arr, JsValue skip) {
  JsValue out = JS.array();
  int n = len(arr);
  int i = 0;
  while (i < n) {
    if (!JS.strictEqual(arr[i], skip)) {
      push(out, arr[i]);
    }
    i = i + 1;
  }
  return out;
}

export bool hasObservers(JsValue observable) {
  return observable["observers_"].truthy() && observable["observers_"]["size"].truthy();
}

export JsValue getObservers(JsValue observable) {
  return observable["observers_"];
}

export void addObserver(JsValue observable, JsValue node) {
  setAdd(observable["observers_"], node);
  if (toInt(observable["lowestObserverState_"]) > toInt(node["dependenciesState_"])) {
    observable["lowestObserverState_"] = node["dependenciesState_"];
  }
}

export void queueForUnobservation(JsValue observable) {
  if (!observable["isPendingUnobservation"].truthy()) {
    observable["isPendingUnobservation"] = true;
    push(globalState["pendingUnobservations"], observable);
  }
}

export void removeObserver(JsValue observable, JsValue node) {
  setDelete(observable["observers_"], node);
  if (!observable["observers_"]["size"].truthy()) {
    queueForUnobservation(observable);
  }
}

export void startBatch() {
  globalState["inBatch"] = toInt(globalState["inBatch"]) + 1;
}

export void endBatch() {
  int next = toInt(globalState["inBatch"]) - 1;
  globalState["inBatch"] = next;
  if (next == 0) {
    runReactions();
    JsValue list = globalState["pendingUnobservations"];
    int i = 0;
    while (i < len(list)) {
      JsValue observable = list[i];
      observable["isPendingUnobservation"] = false;
      if (!observable["observers_"]["size"].truthy()) {
        if (observable["isBeingObserved"].truthy()) {
          observable["isBeingObserved"] = false;
          invoke0(observable, "onBUO");
        }
        if (isComputedValue(observable)) {
          invoke0(observable, "suspend_");
        }
      }
      i = i + 1;
    }
    globalState["pendingUnobservations"] = JS.array();
  }
}

export void checkIfStateReadsAreAllowed(JsValue observable) {
  if (DEV && !globalState["allowStateReads"].truthy() && globalState["observableRequiresReaction"].truthy()) {
    warn("[mobx] Observable '" + toStr(observable["name_"]) + "' being read outside a reactive context.");
  }
}

export bool reportObserved(JsValue observable) {
  if (DEV && !globalState["allowStateReads"].truthy() && globalState["observableRequiresReaction"].truthy()) {
    warn("[mobx] Observable '" + toStr(observable["name_"]) + "' being read outside a reactive context.");
  }
  JsValue derivation = globalState["trackingDerivation"];
  if (!JS.isNullish(derivation)) {
    if (!JS.strictEqual(derivation["runId_"], observable["lastAccessedBy_"])) {
      observable["lastAccessedBy_"] = derivation["runId_"];
      int count = toInt(derivation["unboundDepsCount_"]);
      derivation["newObserving_"][count] = observable;
      derivation["unboundDepsCount_"] = count + 1;
      if (!observable["isBeingObserved"].truthy() && globalState["trackingContext"].truthy()) {
        observable["isBeingObserved"] = true;
        invoke0(observable, "onBO");
      }
    }
    return observable["isBeingObserved"].truthy();
  } else if (!observable["observers_"]["size"].truthy() && globalState["inBatch"].truthy()) {
    queueForUnobservation(observable);
  }
  return false;
}

JsValue propagateChangedEach = JS.method1((JsValue _self, JsValue d) => {
  if (!d["dependenciesState_"].truthy()) {
    invoke0(d, "onBecomeStale_");
  }
  d["dependenciesState_"] = STALE;
  return undef();
});

JsValue propagateMaybeChangedEach = JS.method1((JsValue _self, JsValue d) => {
  if (!d["dependenciesState_"].truthy()) {
    d["dependenciesState_"] = POSSIBLY_STALE;
    invoke0(d, "onBecomeStale_");
  }
  return undef();
});

JsValue confirmedObservable = undef();
JsValue propagateChangeConfirmedEach = JS.method1((JsValue _self, JsValue d) => {
  JsValue state = d["dependenciesState_"];
  if (JS.strictEqual(state, POSSIBLY_STALE)) {
    d["dependenciesState_"] = STALE;
  } else if (!state.truthy()) {
    confirmedObservable["lowestObserverState_"] = UP_TO_DATE;
  }
  return undef();
});

export void propagateChanged(JsValue observable) {
  if (JS.strictEqual(observable["lowestObserverState_"], STALE)) {
    return;
  }
  observable["lowestObserverState_"] = STALE;
  JS.invoke(observable["observers_"], "forEach", propagateChangedEach);
}

export void propagateChangeConfirmed(JsValue observable) {
  if (JS.strictEqual(observable["lowestObserverState_"], STALE)) {
    return;
  }
  observable["lowestObserverState_"] = STALE;
  JsValue prev = confirmedObservable;
  confirmedObservable = observable;
  JS.invoke(observable["observers_"], "forEach", propagateChangeConfirmedEach);
  confirmedObservable = prev;
}

export void reportChanged(JsValue observable) {
  startBatch();
  propagateChanged(observable);
  endBatch();
}

export void propagateMaybeChanged(JsValue observable) {
  if (observable["lowestObserverState_"].truthy()) {
    return;
  }
  observable["lowestObserverState_"] = POSSIBLY_STALE;
  JS.invoke(observable["observers_"], "forEach", propagateMaybeChangedEach);
}

export JsValue untrackedStart() {
  JsValue prev = globalState["trackingDerivation"];
  globalState["trackingDerivation"] = null;
  return prev;
}

export void untrackedEnd(JsValue prev) {
  globalState["trackingDerivation"] = prev;
}

export JsValue untracked = JS.method1((JsValue _self, JsValue actionFn) => {
  JsValue prev = untrackedStart();
  try {
    return call0(actionFn, undef());
  } finally {
    untrackedEnd(prev);
  }
});

export bool allowStateReadsStart(bool allowStateReads) {
  bool prev = globalState["allowStateReads"].truthy();
  globalState["allowStateReads"] = allowStateReads;
  return prev;
}

export void allowStateReadsEnd(bool prev) {
  globalState["allowStateReads"] = prev;
}

export bool allowStateChangesStart(bool allow) {
  bool prev = globalState["allowStateChanges"].truthy();
  globalState["allowStateChanges"] = allow;
  return prev;
}

export void allowStateChangesEnd(bool prev) {
  globalState["allowStateChanges"] = prev;
}

export JsValue allowStateChanges = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue allow = args[0];
  JsValue callback = args[1];
  bool prev = allowStateChangesStart(allow.truthy());
  try {
    return call0(callback, undef());
  } finally {
    allowStateChangesEnd(prev);
  }
});

export void checkIfStateModificationsAreAllowed(JsValue atom) {
  if (!DEV) {
    return;
  }
  bool hasObs = sizeOf(atom["observers_"]) > 0;
  if (!globalState["allowStateChanges"].truthy() && (hasObs || JS.strictEqual(globalState["enforceActions"], "always"))) {
    string msg = "Side effects like changing state are not allowed at this point. Are you trying to modify state from, for example, a computed value or the render function of a React component? You can wrap side effects in 'runInAction' (or decorate functions with 'action') if needed. Tried to modify: ";
    if (globalState["enforceActions"].truthy()) {
      msg = "Since strict-mode is enabled, changing (observed) observable values without using an action is not allowed. Tried to modify: ";
    }
    warn("[MobX] " + msg + toStr(atom["name_"]));
  }
}

export void changeDependenciesStateTo0(JsValue derivation) {
  if (toInt(derivation["dependenciesState_"]) == UP_TO_DATE) {
    return;
  }
  derivation["dependenciesState_"] = UP_TO_DATE;
  JsValue obs = derivation["observing_"];
  int i = len(obs);
  while (i > 0) {
    i = i - 1;
    obs[i]["lowestObserverState_"] = UP_TO_DATE;
  }
}

export bool isComputingDerivation() {
  return !JS.isNullish(globalState["trackingDerivation"]);
}

export JsValue CaughtException = JS.method1((JsValue self, JsValue cause) => {
  self["cause"] = cause;
  return self;
});
defineProperty(CaughtException, "name", record {
  value: "CaughtException",
  configurable: true
});

CaughtException["prototype"]["isMobXCaughtException"] = true;

export bool isCaughtException(JsValue e) {
  return isObj(e) && JS.strictEqual(e["isMobXCaughtException"], true);
}

export bool shouldCompute(JsValue derivation) {
  int state = toInt(derivation["dependenciesState_"]);
  if (state == UP_TO_DATE) {
    return false;
  }
  if (state == NOT_TRACKING || state == STALE) {
    return true;
  }
  if (state == POSSIBLY_STALE) {
    bool prevAllowStateReads = true;
    if (DEV) {
      prevAllowStateReads = allowStateReadsStart(true);
    }
    JsValue prevUntracked = untrackedStart();
    JsValue obs = derivation["observing_"];
    int n = len(obs);
    int i = 0;
    while (i < n) {
      JsValue obj = obs[i];
